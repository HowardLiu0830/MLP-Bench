# Copy to `.env` at the repo root and fill in.
# Names only here -- never commit a filled-in copy; `.env` is gitignored.
#
# Search order: $MLPBENCH_ENV_FILE, ./.env, <data root>/.env, $XDG_CONFIG_HOME/mlpbench/env.
# A variable already set in the environment always wins over the file.

# Needed only for models routed through OpenRouter (the `or:` and `orc:` aliases, and the
# LiteLLM proxy when it runs with running/open_source/litellm.openrouter.yaml).
OPENROUTER_API_KEY=

# Optional: gated Hugging Face weights, if you serve an open-weights model yourself.
HF_TOKEN=

# --- optional overrides; the defaults are usually right ---------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MLPBENCH_PROXY_URL=http://127.0.0.1:<4000+uid%1000>   # LiteLLM, for `local:` / `orc:`
# CLAUDE_BIN=                                   # if the CLI is not on PATH
# CODEX_BIN=
# BWRAP_BIN=

# --- open-weights models -----------------------------------------------------------
# MLPBENCH_VLLM_URL=http://127.0.0.1:<8000+uid%1000>/v1   # where serve_vllm.sh listens
# MLPBENCH_MAX_TOKENS=32768                               # HTTP answer budget (incl. reasoning)

# --- FL verification, agentic -------------------------------------------------------
# MLPBENCH_SAFE_UPSTREAM=/path/to/Safe   # clone of github.com/liuchengwucn/Safe, whose
#                                        # prompts/formalize.txt the paper ran. setup.sh
#                                        # fetches it to ~/.local/share/mlpbench/Safe.

# --- where things go --------------------------------------------------------------
# MLPBENCH_DATA_ROOT=          # required only for a non-editable install
# MLPBENCH_RUNS_ROOT=          # default: ./runs
# MLPBENCH_WORKSPACE=          # default: $XDG_CACHE_HOME/mlpbench/workspace
# MLPBENCH_LEAN_PROJECT=       # default: $XDG_DATA_HOME/mlpbench/lean_project

# --- CPU budget on a shared machine -------------------------------------------------
# MLPBENCH_CPU_LIST=0-51       # pin the set explicitly
# MLPBENCH_CPU_SHARE=0.75      # else: this fraction of the currently idle cores
# MLPBENCH_LEAN_THREADS=2
